# ============================================================
# Smart E-commerce Price Tracker - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.

# --- Database ---
DATABASE_URL=sqlite:///data/price_tracker.db
# For PostgreSQL: postgresql://user:password@localhost:5432/price_tracker

# --- Scheduler ---
# Interval in minutes between automatic price checks
CHECK_INTERVAL_MINUTES=30

# --- Email Notifications (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_RECIPIENT=recipient@example.com

# --- Scraping ---
# Request timeout in seconds
REQUEST_TIMEOUT=15
# Delay between requests (seconds) to avoid rate limiting
SCRAPE_DELAY=2

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/price_tracker.log
